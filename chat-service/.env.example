# Konfigurasi Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11435
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_S=180
OLLAMA_MAX_RETRIES=1

# Konfigurasi Laravel API
LARAVEL_API_URL=http://localhost:8000

# Konfigurasi CORS (comma-separated, tanpa spasi)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Rate Limiting (request per menit per IP)
RATE_LIMIT_PER_MINUTE=20

# Session TTL (dalam menit)
SESSION_TTL_MINUTES=60

# Redis — Tier 3 persistent session store (Sprint C2.1B: shared Redis, see
# docs/c2-1b-shared-redis-cutover.md). Built from these components, not a
# credential-bearing URL. USERNAME/PASSWORD blank = no AUTH, for a bare
# local Redis; production requires both against the shared instance.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
# Key-namespace boundary on shared Redis, not the same thing as REDIS_DB --
# production sets this to "blukios:" so keys stay inside the ACL-restricted
# blukios:* pattern instead of relying on the logical DB number for isolation.
REDIS_KEY_PREFIX=
