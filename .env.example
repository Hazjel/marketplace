# Root .env — read by docker-compose.yml.
# Copy to .env and fill in the required values below.
#
#   cp .env.example .env
#
# Everything else has a working local-development default in the Compose
# file; override here only what you need.

# ─── Required (Compose fails to start without these) ──────────────────
# APP_KEY — a Laravel app key. Generate one without bootstrapping anything:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# (or `php api-blue/artisan key:generate --show` if api-blue is vendored)
APP_KEY=
# INTERNAL_SERVICE_KEY — shared secret between the Laravel API and the Python
# services for /internal/*. Any long random string, identical in every service:
#   openssl rand -hex 32
INTERNAL_SERVICE_KEY=
# REDIS_USERNAME / REDIS_PASSWORD — credentials for the shared Redis instance
# (Sprint C2.1B, see docs/c2-1b-shared-redis-cutover.md). The local blue-redis
# service is retired; every Redis-using container now requires these. Never
# put a real production password here — this file is committed.
REDIS_USERNAME=
REDIS_PASSWORD=
# DB_USERNAME / DB_PASSWORD -- credentials for the shared Postgres instance in
# /opt/shared-infra. MySQL (blue-mysql, root with an empty password) is gone;
# shared Postgres has no anonymous user, so these have no default and Compose
# refuses to start without them. Never put a real production password here --
# this file is committed.
DB_USERNAME=
DB_PASSWORD=
# DB_MONGO_USERNAME / DB_MONGO_PASSWORD -- same story for the shared Mongo
# instance, which unlike the retired blue-mongo requires authentication.
DB_MONGO_USERNAME=
DB_MONGO_PASSWORD=

# ─── Common local overrides (optional) ───────────────────────────────
# REDIS_HOST=shared-redis        # host:port/db of the shared Redis instance
# REDIS_PORT=6379
# REDIS_DB=0                     # chat-service only; Laravel splits db 0/1 itself
# REDIS_PREFIX=blukios:          # key-namespace boundary, not a Redis logical DB --
#                                 # shared Redis already has other services' keys
#                                 # (e.g. prefix `asynq:`) in the same db.
# APP_ENV=production            # Compose default; set to `local` for Whoops/Ignition
# APP_DEBUG=false               # Compose default; never true in a deployment
# APP_URL=http://localhost
# NGINX_HOST_PORT=80
# DB_HOST=shared-postgres       # host/port/db of the shared Postgres instance
# DB_PORT=5432
# DB_DATABASE=blukios
# DB_MONGO_HOST=shared-mongo
# DB_MONGO_PORT=27017
# DB_MONGO_DATABASE=blukios_mongo
# DB_MONGO_AUTHENTICATION_DATABASE=admin

# Frontend origins (buyer + seller). Comma-separated, no spaces.
# FRONTEND_URLS=http://localhost,http://localhost:5173,http://localhost:5174
# BUYER_APP_URL=http://localhost
# SELLER_APP_URL=http://localhost:8090

# Reverb (WebSocket). Defaults are dev-only placeholders.
# REVERB_APP_KEY=reverbkey
# REVERB_APP_SECRET=reverbsecret

# ─── Third-party (leave blank to run without them) ───────────────────
# MIDTRANS_SERVER_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=
# KOMERCE_API_KEY=
# KEY_RAJA_ONGKIR=
# Email keluar (reset password, verifikasi email). Default: Gmail SMTP dengan App Password.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=noreply@blukios.com
#
# Cloudflare Email Service (domain harus di-onboard untuk Email Sending; token API
# butuh izin "Email Sending: Edit"; kirim ke penerima sembarang butuh Workers Paid):
# MAIL_HOST=smtp.mx.cloudflare.net
# MAIL_PORT=465
# MAIL_USERNAME=api_token
# MAIL_PASSWORD=<token API Cloudflare>
# MAIL_FROM_ADDRESS=noreply@blukios.store   # harus di domain yang di-onboard

# ─── Container user mapping (Linux hosts, optional) ──────────────────
# HOST_UID=1000
# HOST_GID=1000
