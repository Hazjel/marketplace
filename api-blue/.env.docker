# Docker override — only values that differ from .env
DB_HOST=mysql
DB_MONGO_HOST=mongodb
# Shared Redis (Sprint C2.1B) -- see docs/c2-1b-shared-redis-cutover.md.
# USERNAME/PASSWORD/PREFIX come from real container env vars (docker-compose.yml),
# not this merge file -- phpdotenv never overwrites an already-set env var.
REDIS_HOST=shared-redis
